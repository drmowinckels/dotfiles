  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; ext=\"${f##*.}\"; if echo \"$ext\" | grep -qE '^(html|scss|toml)$'; then dir=\"$f\"; while [ \"$dir\" != \"/\" ]; do dir=\"$(dirname \"$dir\")\"; if [ -f \"$dir/hugo.toml\" ] || [ -f \"$dir/config.toml\" ] || [ -f \"$dir/config/_default/hugo.toml\" ]; then cd \"$dir\" && hugo build --quiet 2>&1 | tail -5; exit $?; fi; done; fi; }",
            "timeout": 30,
            "statusMessage": "Verifying Hugo build..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qiE '\\.[rR]$'; then /opt/homebrew/bin/air format \"$f\" 2>&1; fi; }",
            "timeout": 30,
            "statusMessage": "Formatting R file with air..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qiE '\\.(ya?ml|json|css|scss|html|md|qmd)$'; then /opt/homebrew/bin/prettier --write \"$f\" 2>&1; fi; }",
            "timeout": 30,
            "statusMessage": "Formatting with prettier..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qiE '\\.(sh|bash|zsh)$'; then /opt/homebrew/bin/shfmt -w -i 2 \"$f\" 2>&1; fi; }",
            "timeout": 30,
            "statusMessage": "Formatting shell script with shfmt..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qE '\\.R$'; then Rscript -e \"lintr::lint('$f')\" 2>&1 | tail -20; fi; }",
            "timeout": 30,
            "statusMessage": "Linting R file..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qE '\\.R$'; then dir=\"$f\"; while [ \"$dir\" != \"/\" ]; do dir=\"$(dirname \"$dir\")\"; if [ -f \"$dir/DESCRIPTION\" ]; then cd \"$dir\" && Rscript -e 'devtools::test()' 2>&1 | tail -20; exit $?; fi; done; fi; }",
            "timeout": 120,
            "statusMessage": "Running R tests..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qE '\\.R$'; then dir=\"$f\"; while [ \"$dir\" != \"/\" ]; do dir=\"$(dirname \"$dir\")\"; if [ -f \"$dir/DESCRIPTION\" ]; then cd \"$dir\" && Rscript -e 'devtools::check()' 2>&1 | tail -30; exit $?; fi; done; fi; }",
            "timeout": 600,
            "statusMessage": "Running R CMD check..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "r-lib@posit-dev-skills": true,
    "quarto@posit-dev-skills": true,
    "shiny@posit-dev-skills": true,
    "open-source@posit-dev-skills": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true,
    "writing-voices@straight-talk": true,
    "posit-dev@posit-dev-skills": true
  },
  "effortLevel": "medium",
