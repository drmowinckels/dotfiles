{
  "env": {
    "R_LIBS_USER": "~/R/library",
    "GITHUB_PAT": "${GITHUB_PAT}"
  },
  "permissions": {
    "allow": [
      "Bash(R:*)",
      "Bash(Rscript:*)",
      "Bash(/opt/homebrew/bin/Rscript:*)",
      "Bash(/usr/local/bin/Rscript:*)",
      "Bash(/usr/local/bin/R:*)",
      "Bash(/Library/Frameworks/R.framework/Versions/4.5-arm64/Resources/bin/Rscript:*)",
      "Bash(RENV_PROFILE=default:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(hugo:*)",
      "Bash(quarto:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(uv:*)",
      "Bash(brew:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(kill:*)",
      "Bash(export:*)",
      "Bash(file:*)",
      "Bash(xxd:*)",
      "Bash(for:*)",
      "Bash(if:*)",
      "Bash(zsh -c:*)",
      "WebFetch",
      "WebSearch",
      "Read(//Users/athanasm/**)",
      "Read(//Applications/**)",
      "Read(//opt/homebrew/**)",
      "Read(//Library/Frameworks/**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Read(//usr/local/bin/**)",
      "Bash(done)",
      "Bash(Rscript -e 'devtools::test\\(\\)')",
      "Bash(pdftotext /Users/athanasm/workspace/rladies/branding-materials/Branding-guidelines.pdf -)",
      "Bash(sips -g pixelWidth -g pixelHeight /Users/athanasm/workspace/rladies/rladiesguide/content/branding/affinity-logo/img-01.png /Users/athanasm/workspace/rladies/rladiesguide/content/branding/affinity-logo/img-04.png)",
      "Bash(sips --resampleWidth 1800 /Users/athanasm/workspace/rladies/rladiesguide/content/branding/affinity-logo/img-01.png --out /tmp/img-01-resized.png)",
      "Bash(sips --resampleWidth 1800 /Users/athanasm/workspace/rladies/rladiesguide/content/branding/affinity-logo/img-04.png --out /tmp/img-04-resized.png)",
      "Bash(sips -g pixelWidth -g pixelHeight /Users/athanasm/workspace/rladies/rladiesguide/content/branding/hex-logos/img-01.png)",
      "Bash(mkdir -p /tmp/rladies-resized)",
      "Bash(do convert:*)",
      "Bash(Rscript -e 'devtools::document\\(\\)')",
      "Bash(RENV_PROFILE=default Rscript -e ':*)",
      "mcp__puppeteer__puppeteer_click",
      "mcp__puppeteer__puppeteer_screenshot",
      "mcp__puppeteer__puppeteer_evaluate",
      "mcp__puppeteer__puppeteer_navigate",
      "Bash(/opt/homebrew/bin/gh run *)",
      "Bash(/opt/homebrew/bin/gh pr create --title 'Install Node 20 via tarball to fix bot image build' --body ' *)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/athanasm/Downloads",
      "/Users/athanasm/workspace/rladies/rladiesguide/content/branding",
      "/Users/athanasm/workspace/ggseg/ggseg.formats/tests/testthat",
      "/Users/athanasm/workspace/ggseg/ggseg3d/tests/testthat",
      "/Users/athanasm/workspace/ggseg/ggseg.extra/R",
      "/Users/athanasm/workspace/ggseg/atlases/ggsegShen/data-raw/shen268/shen268"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; ext=\"${f##*.}\"; if echo \"$ext\" | grep -qE '^(html|scss|toml)$'; then dir=\"$f\"; while [ \"$dir\" != \"/\" ]; do dir=\"$(dirname \"$dir\")\"; if [ -f \"$dir/hugo.toml\" ] || [ -f \"$dir/config.toml\" ] || [ -f \"$dir/config/_default/hugo.toml\" ]; then cd \"$dir\" && hugo build --quiet 2>&1 | tail -5; exit $?; fi; done; fi; }",
            "timeout": 30,
            "statusMessage": "Verifying Hugo build..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qiE '\\.[rR]$'; then /opt/homebrew/bin/air format \"$f\" 2>&1; fi; }",
            "timeout": 30,
            "statusMessage": "Formatting R file with air..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qiE '\\.(ya?ml|json|css|scss|html|md|qmd)$'; then /opt/homebrew/bin/prettier --write \"$f\" 2>&1; fi; }",
            "timeout": 30,
            "statusMessage": "Formatting with prettier..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qiE '\\.(sh|bash|zsh)$'; then /opt/homebrew/bin/shfmt -w -i 2 \"$f\" 2>&1; fi; }",
            "timeout": 30,
            "statusMessage": "Formatting shell script with shfmt..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qE '\\.R$'; then Rscript -e \"lintr::lint('$f')\" 2>&1 | tail -20; fi; }",
            "timeout": 30,
            "statusMessage": "Linting R file..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qE '\\.R$'; then dir=\"$f\"; while [ \"$dir\" != \"/\" ]; do dir=\"$(dirname \"$dir\")\"; if [ -f \"$dir/DESCRIPTION\" ]; then cd \"$dir\" && Rscript -e 'devtools::test()' 2>&1 | tail -20; exit $?; fi; done; fi; }",
            "timeout": 120,
            "statusMessage": "Running R tests..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if echo \"$f\" | grep -qE '\\.R$'; then dir=\"$f\"; while [ \"$dir\" != \"/\" ]; do dir=\"$(dirname \"$dir\")\"; if [ -f \"$dir/DESCRIPTION\" ]; then cd \"$dir\" && Rscript -e 'devtools::check()' 2>&1 | tail -30; exit $?; fi; done; fi; }",
            "timeout": 600,
            "statusMessage": "Running R CMD check..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "r-lib@posit-dev-skills": true,
    "quarto@posit-dev-skills": true,
    "shiny@posit-dev-skills": true,
    "open-source@posit-dev-skills": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true,
    "writing-voices@straight-talk": true,
    "posit-dev@posit-dev-skills": true
  },
  "effortLevel": "medium",
  "fileExclusions": [
    ".Rproj.user/**",
    ".Rhistory",
    ".RData",
    ".Ruserdata",
    "*_cache/**",
    "*.Rproj",
    "node_modules/**",
    ".git/**",
    "*.log",
    "revdep/**",
    "docs/**",
    "*.html",
    "*.pdf",
    ".httr-oauth",
    ".DS_Store",
    "public/**",
    "resources/**",
    ".hugo_build.lock"
  ]
}
